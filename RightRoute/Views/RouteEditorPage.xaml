<?xml version="1.0" encoding="utf-8" ?>
<maui:ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
                  xmlns:maui="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:viewmodels="clr-namespace:RightRoute.ViewModels"
                  x:Class="RightRoute.Views.RouteEditorPage"
                  Title="{maui:Binding CurrentRoute.Name}">

    <!-- Vertical Stack holds the whole page layout scrolling naturally -->
    <maui:ScrollView Padding="20">
        <maui:VerticalStackLayout Spacing="15">

            <!-- SECTION 1: Route Metadata Config -->
            <maui:HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <maui:Label Text="Loadout Name:" VerticalOptions="Center" FontAttributes="Bold"/>
                <maui:Entry Text="{maui:Binding CurrentRoute.Name}" WidthRequest="200" />
            </maui:HorizontalStackLayout>

            <maui:BoxView HeightRequest="1" Color="LightGray" />

            <!-- SECTION 2: Add New Waypoint Form (Streamlined Address Search) -->
            <maui:Label Text="Where do you want to go?" FontSize="18" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*, 60" ColumnSpacing="10">

				<!-- One big friendly input field for typing addresses -->
				<maui:Entry Grid.Column="0"
					   Text="{maui:Binding NewWaypointDescription}" 
					   Placeholder="Type address here... (e.g., 123 Main St, Seattle)" 
					   ReturnCommand="{maui:Binding AddWaypointCommand}" />

				<!-- Big click button to submit the line item -->
				<maui:Button Grid.Column="1" 
						Text="+" 
						FontAttributes="Bold"
						FontSize="20"
						Command="{maui:Binding AddWaypointCommand}" 
						BackgroundColor="DarkSlateBlue" 
						TextColor="White"/>
            </Grid>

            <maui:Label Text="(Optional: Leave input field blank and fill boxes below to input raw coordinates instead)" FontSize="11" TextColor="Gray" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
                <maui:Entry Text="{maui:Binding NewLatitude}" Placeholder="Manual Lat (Optional)" Keyboard="Numeric" FontSize="12"/>
                <maui:Entry Text="{maui:Binding NewLongitude}" Placeholder="Manual Lng (Optional)" Keyboard="Numeric" FontSize="12"/>
            </Grid>

            <maui:BoxView HeightRequest="1" Color="LightGray" />

            <!-- SECTION 3: Strategy Options (Toggles) -->
            <maui:HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                <maui:Label Text="Return to start at end of route?" VerticalOptions="Center" />
                <maui:Switch IsToggled="{maui:Binding IsRoundTrip}" />
            </maui:HorizontalStackLayout>

            <!-- SECTION 4: View Current Active List Slots -->
            <maui:Label Text="Stops In Current Loadout:" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>

            <!-- ListView loops through added targets and provides individual item deletion -->
            <maui:CollectionView ItemsSource="{maui:Binding Waypoints}" EmptyView="No stops added to this loadout yet.">
                <maui:CollectionView.ItemTemplate>
                    <maui:DataTemplate>
                        <maui:Grid ColumnDefinitions="Auto, *, Auto" Padding="5" VerticalOptions="Center">
                            <!-- Sequential Ordering Index Indicator badge -->
                            <maui:Border Grid.Column="0" StrokeShape="RoundRectangle 4" BackgroundColor="LightBlue" WidthRequest="24" HeightRequest="24" Margin="0,0,10,0">
                                <maui:Label Text="{maui:Binding SequenceOrder}" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" FontAttributes="Bold"/>
                            </maui:Border>

                            <maui:VerticalStackLayout Grid.Column="1">
                                <maui:Label Text="{maui:Binding Description}" FontAttributes="Bold" />
                                <maui:Label Text="{maui:Binding Latitude, StringFormat='Lat: {0}'}" FontSize="12" TextColor="Gray" />
                                <maui:Label Text="{maui:Binding Longitude, StringFormat='Lng: {0}'}" FontSize="12" TextColor="Gray" />
                            </maui:VerticalStackLayout>

                            <!-- Swipe/Delete row target trigger button context -->
                            <maui:Button Grid.Column="2" 
                                    Text="🗑" 
                                    TextColor="Red"
                                    BackgroundColor="Transparent"
                                    Command="{maui:Binding Source={RelativeSource AncestorType={x:Type viewmodels:RouteEditorViewModel}}, Path=RemoveWaypointCommand}"
                                    CommandParameter="{maui:Binding .}" />
                        </maui:Grid>
                    </maui:DataTemplate>
                </maui:CollectionView.ItemTemplate>
            </maui:CollectionView>

            <maui:BoxView HeightRequest="1" Color="LightGray" Margin="0,10,0,0" />

            <!-- SECTION 5: Form Action Buttons -->
            <maui:Grid ColumnDefinitions="*, *, *" ColumnSpacing="10" Margin="0,10,0,0">
                <maui:Button Grid.Column="0" 
                        Text="Optimize Path" 
                        Command="{maui:Binding OptimizeRouteSequenceCommand}" 
                        BackgroundColor="DarkSlateBlue" 
                        TextColor="White" />

                <maui:Button Grid.Column="1" 
                        Text="Save Loadout" 
                        Command="{maui:Binding SaveLoadoutCommand}" 
                        BackgroundColor="Green" 
                        TextColor="White" />

                <maui:Button Grid.Column="2" 
                        Text="Launch Maps" 
                        Command="{maui:Binding LaunchNativeMapsCommand}" 
                        BackgroundColor="OrangeRed" 
                        TextColor="White" />
            </maui:Grid>

        </maui:VerticalStackLayout>
    </maui:ScrollView>
</maui:ContentPage>
